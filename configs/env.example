export HYBRID_COMPUTER_USE_ROOT="$(pwd)"
export HCU_ARTIFACT_DIR="${HYBRID_COMPUTER_USE_ROOT}/artifacts"
export HCU_RESULTS_DIR="${HYBRID_COMPUTER_USE_ROOT}/runs"

export OSWORLD_V2_ROOT="${HYBRID_COMPUTER_USE_ROOT}/external/OSWorld-V2"

# Model gateways must be reachable from the task container or QEMU guest.
export HCU_DOCKER_GATEWAY="172.28.251.1"
export HCU_OPENAI_GATEWAY="http://${HCU_DOCKER_GATEWAY}:8600"
export HCU_ANTHROPIC_GATEWAY="http://${HCU_DOCKER_GATEWAY}:8537"

# Both benchmark generations use the pinned OSWorld V2 checkout as the host
# runner. V2 additionally requires its local gated asset snapshot.
export OSWORLD_FILE_BASE_URL="/absolute/path/to/osworld-v2-assets"

# Immutable upstream source images. Keep these unchanged.
export OSWORLD_V1_OFFICIAL_IMAGE="/absolute/path/to/v1-official/Ubuntu.qcow2"
export OSWORLD_V1_OFFICIAL_IMAGE_SHA256="6bf667a852b3c307f61d9f09c42559351f45e0607e428b4997becf534cf4d313"
export OSWORLD_V2_OFFICIAL_IMAGE="/absolute/path/to/v2-official.qcow2"
export OSWORLD_V2_OFFICIAL_IMAGE_SHA256="<sha256-of-your-pinned-v2-source>"

# Active official-derived dependency images.
export OSWORLD_V1_GUEST_IMAGE="/absolute/path/to/osworld-v1-ubuntu-workstation-deps-v014-beta1-core-64g.qcow2"
export OSWORLD_V1_GUEST_IMAGE_SHA256="acb8297f6d5e94a2c57eac6db05cc9822939d2c6389ce52cec5eb93306139479"
export OSWORLD_V1_VOLUME_SIZE=64
export OSWORLD_V1_CLIENT_PASSWORD="password"

export OSWORLD_V2_GUEST_IMAGE="/absolute/path/to/osworld-v2-ubuntu-workstation-deps-v014-beta1-100g.qcow2"
export OSWORLD_V2_GUEST_IMAGE_SHA256="76d3eebed863d6834254729c2bd7805d080cfbf3f6de1c4036a78d8b010f404a"
export OSWORLD_V2_VOLUME_SIZE=100
export OSWORLD_V2_CLIENT_PASSWORD="osworld-public-evaluation"

# Optional strict dedicated-daemon checks.
export OSWORLD_V2_REQUIRE_DEDICATED_DOCKER=0
export OSWORLD_V2_DOCKER_HOST="${DOCKER_HOST:-unix:///var/run/docker.sock}"
export OSWORLD_V2_DOCKER_ROOT=""
