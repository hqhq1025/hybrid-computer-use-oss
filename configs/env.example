export HYBRID_COMPUTER_USE_ROOT="$(pwd)"
export HCU_ARTIFACT_DIR="${HYBRID_COMPUTER_USE_ROOT}/artifacts"
export HCU_RESULTS_DIR="${HYBRID_COMPUTER_USE_ROOT}/runs"

export OSWORLD_V2_ROOT="${HYBRID_COMPUTER_USE_ROOT}/external/OSWorld-V2"

# Model gateways must be reachable from the task container or QEMU guest.
# 172.17.0.1 is the gateway of Docker's default bridge; use the gateway of the
# bridge your OSWorld containers join.
export HCU_DOCKER_GATEWAY="172.17.0.1"
export HCU_OPENAI_GATEWAY="http://${HCU_DOCKER_GATEWAY}:8611"
export HCU_ANTHROPIC_GATEWAY="http://${HCU_DOCKER_GATEWAY}:8537"
export HCU_GEMINI_GATEWAY="http://${HCU_DOCKER_GATEWAY}:8571"

# Both benchmark generations use the pinned OSWorld V2 checkout as the host
# runner. V2 additionally requires its local gated asset snapshot.
export OSWORLD_FILE_BASE_URL="/absolute/path/to/osworld-v2-assets"

# Guest images. Volume size, RAM size and the guest password belong to the
# batch or queue configuration, not here.
export OSWORLD_V1_GUEST_IMAGE="/absolute/path/to/osworld-v1-workstation-deps-64g.qcow2"
export OSWORLD_V2_GUEST_IMAGE="/absolute/path/to/osworld-v2-workstation-deps-100g.qcow2"

# Optional strict dedicated-daemon checks.
export OSWORLD_V2_REQUIRE_DEDICATED_DOCKER=0
export OSWORLD_V2_DOCKER_HOST="${DOCKER_HOST:-unix:///var/run/docker.sock}"
export OSWORLD_V2_DOCKER_ROOT=""

# Default queue configuration for `python -m hcu.osworld.run_queue`.
export HCU_QUEUE="${HYBRID_COMPUTER_USE_ROOT}/configs/osworld-v2-codex-queue.example.json"
