FROM golang:1.22@sha256:1cf6c45ba39db9fd6db16922041d074a63c935556a05c5ccb62d181034df7f02 AS builder

WORKDIR /src
COPY computer-use/ ./
RUN test -z "$(/usr/local/go/bin/gofmt -l .)" \
    && /usr/local/go/bin/go test ./... \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 /usr/local/go/bin/go build \
       -trimpath \
       -ldflags "-s -w -X main.version=0.70.0-beta.70+osw-v013-gui-native-1080p" \
       -o /out/computer-use . \
    && test "$(/out/computer-use --version)" = \
       "0.70.0-beta.70+osw-v013-gui-native-1080p"

FROM scratch AS export
COPY --from=builder /out/computer-use /computer-use
