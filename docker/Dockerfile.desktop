# Adds the computer-use binary, its Linux provider dependencies and the agent
# CLIs to a desktop image that already runs the OSWorld guest server.
# Build the binary first with `make build` and fetch the agents with
# `make agents`.
ARG OSWORLD_BASE_IMAGE
FROM ${OSWORLD_BASE_IMAGE}
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-gi gir1.2-atspi-2.0 gir1.2-gtk-3.0 \
       gir1.2-gdkpixbuf-2.0 xdotool wmctrl x11-utils \
    && rm -rf /var/lib/apt/lists/*
COPY artifacts/computer-use /usr/local/bin/computer-use
COPY artifacts/codex /usr/bin/codex
COPY artifacts/claude-code /usr/bin/claude
RUN chmod 0755 /usr/local/bin/computer-use /usr/bin/codex /usr/bin/claude
USER user
