FROM golang:1.22@sha256:1cf6c45ba39db9fd6db16922041d074a63c935556a05c5ccb62d181034df7f02 AS computer-use-builder

WORKDIR /src
COPY computer-use/ ./
RUN test -z "$(/usr/local/go/bin/gofmt -l .)" \
    && /usr/local/go/bin/go test ./... \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 /usr/local/go/bin/go build -trimpath \
        -ldflags "-s -w \
          -X main.version=0.70.0-beta.70+osw-v013-gui-native-1080p" \
        -o /out/computer-use . \
    && /out/computer-use --version

# This is the exact historical release layering contract. Import or rebuild
# osw-hybrid:v0.13 before using this file.
FROM osw-hybrid:v0.13
USER root
COPY --from=computer-use-builder /out/computer-use /usr/local/bin/computer-use
RUN chmod 0755 /usr/local/bin/computer-use \
    && test "$(/usr/local/bin/computer-use --version)" = \
      "0.70.0-beta.70+osw-v013-gui-native-1080p"

LABEL org.osw-hybrid.baseline-tool-version="v0.13" \
      org.osw-hybrid.tool-change="v013-gui-native-1080p-beta70" \
      org.osw-hybrid.release-status="unreleased-beta"

USER user
